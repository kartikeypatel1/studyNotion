								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Q.Why we create Payload in JWT authentication?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "In authentication (especially "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "JWT"
								},
								{
									"type": "text",
									"text": "), a "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "payload"
								},
								{
									"type": "text",
									"text": " is the data you want "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "to store inside the token. We create a payload so that the server "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "can identify the user without querying the database on every request."
								}
							]
						}
					]
				}
			},
